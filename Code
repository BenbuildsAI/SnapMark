CANVAS_SIZE = 1024
COLOR_FILE = Path.home() / ".snapmark" / "colors.json"


def endpoints(line):
    angle = math.radians(line["angle"])
    dx = math.cos(angle) * line["length"] / 2
    dy = math.sin(angle) * line["length"] / 2

    return [
        QPointF(line["x"] - dx, line["y"] - dy),
        QPointF(line["x"] + dx, line["y"] + dy),
    ]


def distance(a, b):
    return math.hypot(a.x() - b.x(), a.y() - b.y())


def set_endpoints(line, a, b):
    line["x"] = (a.x() + b.x()) / 2
    line["y"] = (a.y() + b.y()) / 2
    line["length"] = max(1, distance(a, b))
    line["angle"] = math.degrees(
        math.atan2(b.y() - a.y(), b.x() - a.x())
    )


def connected_lines(lines, selected_id):
    group = {selected_id}

    while True:
        added = set()

        for first in lines:
            if first["id"] not in group or first.get("kind") == "circle":
                continue

            for second in lines:
                if (
                    second.get("kind") == "circle"
                    or second["id"] in group
                    or second["hidden"]
                    or second["locked"]
                ):
                    continue

                if any(
                    distance(a, b) < 0.1
                    for a in endpoints(first)
                    for b in endpoints(second)
                ):
                    added.add(second["id"])

        if not added:
            return group

        group.update(added)


def closed_shapes(lines):
    """Find closed loops made from connected line endpoints."""
    vertices = []
    edges = []

    def vertex_index(point):
        for index, existing in enumerate(vertices):
            if distance(point, existing) < 2:
                return index

        vertices.append(point)
        return len(vertices) - 1

    for line in lines:
        if line.get("kind") == "circle" or line["hidden"] or line["length"] <= 2:
            continue

        a, b = endpoints(line)
        edges.append(
            (line["id"], vertex_index(a), vertex_index(b))
        )

    adjacency = [[] for _ in vertices]

    for index, (_, a, b) in enumerate(edges):
        adjacency[a].append(index)
        adjacency[b].append(index)

    found = {}

    def walk(start, node, path, used_edges, visited):
        # Keep complex drawings from generating excessive combinations.
        if len(path) > 12:
            return

        for edge_index in adjacency[node]:
            if edge_index in used_edges:
                continue

            _, a, b = edges[edge_index]
            next_node = b if a == node else a

            if next_node == start and len(path) >= 2:
                cycle = path + [edge_index]
                key = "-".join(
                    str(value)
                    for value in sorted(edges[i][0] for i in cycle)
                )

                if key in found:
                    continue

                points = [vertices[i] for i in visited]
                area = abs(
                    sum(
                        point.x() * points[(i + 1) % len(points)].y()
                        - point.y() * points[(i + 1) % len(points)].x()
                        for i, point in enumerate(points)
                    )
                ) / 2

                if area > 20:
                    found[key] = (key, points, area)

            elif next_node not in visited:
                walk(
                    start,
                    next_node,
                    path + [edge_index],
                    used_edges | {edge_index},
                    visited + [next_node],
                )

    for index in range(len(vertices)):
        walk(index, index, [], set(), [index])

    return list(found.values())


def polygon_path(points):
    path = QPainterPath(points[0])

    for point in points[1:]:
        path.lineTo(point)

    path.closeSubpath()
    return path


class ColorWheel(QWidget):
    def __init__(self, color):
        super().__init__()
        self.setFixedSize(240, 240)
        self.hue = max(0, color.hsvHueF())
        self.saturation = color.hsvSaturationF()
        self.value = color.valueF()
        self.changed = lambda: None
        self.started = lambda: None
        self.wheel = QImage(240, 240, QImage.Format.Format_ARGB32)
        self.wheel.fill(Qt.GlobalColor.transparent)
        for y in range(240):
            for x in range(240):
                dx, dy = x - 120, y - 120
                saturation = math.hypot(dx, dy) / 116
                if saturation <= 1:
                    hue = (math.atan2(dy, dx) / (2 * math.pi)) % 1
                    self.wheel.setPixelColor(x, y, QColor.fromHsvF(hue, saturation, 1))

    def color(self):
        return QColor.fromHsvF(self.hue, self.saturation, self.value)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.scale(self.width() / 240, self.height() / 240)
        painter.drawImage(0, 0, self.wheel)
        a = self.hue * 2 * math.pi
        point = QPointF(120 + math.cos(a) * self.saturation * 116,
                        120 + math.sin(a) * self.saturation * 116)
        painter.setPen(QPen(QColor("#101116"), 5))
        painter.drawEllipse(point, 6, 6)
        painter.setPen(QPen(QColor("white"), 2))
        painter.drawEllipse(point, 6, 6)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.started()
            self.pick(event.position())

    def mouseMoveEvent(self, event):
        if event.buttons() & Qt.MouseButton.LeftButton:
            self.pick(event.position())

    def pick(self, point):
        dx, dy = point.x() * 240 / self.width() - 120, point.y() * 240 / self.height() - 120
        self.hue = (math.atan2(dy, dx) / (2 * math.pi)) % 1
        self.saturation = min(1, math.hypot(dx, dy) / 116)
        self.update()
        self.changed()


def choose_wheel_color(initial, parent, title):
    dialog = QDialog(parent)
    dialog.setWindowTitle(title)
    layout = QVBoxLayout(dialog)
    wheel = ColorWheel(initial)
    layout.addWidget(wheel, alignment=Qt.AlignmentFlag.AlignCenter)
    layout.addWidget(QLabel("Brightness"))
    brightness = QSlider(Qt.Orientation.Horizontal)
    brightness.setRange(0, 100)
    brightness.setValue(round(wheel.value * 100))
    layout.addWidget(brightness)
    preview = QLabel()
    preview.setAlignment(Qt.AlignmentFlag.AlignCenter)
    preview.setMinimumHeight(36)
    layout.addWidget(preview)
    def update_preview():
        color = wheel.color()
        preview.setText(color.name().upper())
        ink = "#101116" if color.lightnessF() > .5 else "white"
        preview.setStyleSheet(f"background: {color.name()}; color: {ink}; border-radius: 6px;")
    def set_brightness(value):
        wheel.value = value / 100
        update_preview()
    wheel.changed = update_preview
    brightness.valueChanged.connect(set_brightness)
    update_preview()
    buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
    buttons.accepted.connect(dialog.accept)
    buttons.rejected.connect(dialog.reject)
    layout.addWidget(buttons)
    return wheel.color() if dialog.exec() == QDialog.DialogCode.Accepted else QColor()


class Canvas(QWidget):
    def __init__(self, editor):
        super().__init__()
        self.editor = editor
        self.mode = "select"
        self.drag = None

        self.setMinimumSize(360, 360)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)

    def transform(self):
        scale = min(
            (self.width() - 30) / CANVAS_SIZE,
            (self.height() - 30) / CANVAS_SIZE,
        )

        return (
            scale,
            (self.width() - CANVAS_SIZE * scale) / 2,
            (self.height() - CANVAS_SIZE * scale) / 2,
        )

    def canvas_point(self, event):
        scale, offset_x, offset_y = self.transform()
        point = event.position()

        return QPointF(
            max(0, min(CANVAS_SIZE, (point.x() - offset_x) / scale)),
            max(0, min(CANVAS_SIZE, (point.y() - offset_y) / scale)),
        )

    def snap(self, point, excluded_ids):
        best = point
        threshold = 14 / self.transform()[0]

        for line in self.editor.lines:
            if line.get("kind") == "circle" or line["hidden"] or line["id"] in excluded_ids:
                continue

            for endpoint in endpoints(line):
                amount = distance(point, endpoint)

                if amount < threshold:
                    best = endpoint
                    threshold = amount

        return best

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.fillRect(self.rect(), QColor("#101116"))

        scale, offset_x, offset_y = self.transform()
        painter.translate(offset_x, offset_y)
        painter.scale(scale, scale)

        self.draw_logo(painter, preview=True)
        painter.end()

    def draw_logo(self, painter, preview=False):
        editor = self.editor
        painter.save()
        painter.setClipRect(QRectF(0, 0, CANVAS_SIZE, CANVAS_SIZE))

        if editor.transparent:
            if preview:
                painter.fillRect(
                    QRectF(0, 0, CANVAS_SIZE, CANVAS_SIZE),
                    QColor("white"),
                )

                for y in range(0, CANVAS_SIZE, 64):
                    for x in range(0, CANVAS_SIZE, 64):
                        if (x // 64 + y // 64) % 2:
                            painter.fillRect(
                                QRectF(x, y, 64, 64),
                                QColor("#dddfe4"),
                            )
        else:
            painter.fillRect(
                QRectF(0, 0, CANVAS_SIZE, CANVAS_SIZE),
                QColor(editor.background),
            )

        for key, points, _ in closed_shapes(editor.lines):
            if key in editor.fills:
                painter.fillPath(
                    polygon_path(points),
                    QColor(editor.fills[key]),
                )

        for line in editor.lines:
            if line["hidden"]:
                continue

            cap = (
                Qt.PenCapStyle.RoundCap
                if line["rounded"]
                else Qt.PenCapStyle.FlatCap
            )

            painter.setPen(
                QPen(
                    QColor(line["color"]),
                    line["width"],
                    Qt.PenStyle.SolidLine,
                    cap,
                )
            )

            if line.get("kind") == "circle":
                painter.setBrush(QColor(line["fill"]) if line.get("fill") else Qt.BrushStyle.NoBrush)
                painter.drawEllipse(QPointF(line["x"], line["y"]), line["length"] / 2, line["length"] / 2)
                painter.setBrush(Qt.BrushStyle.NoBrush)
            else:
                a, b = endpoints(line)
                painter.drawLine(a, b)

        line = editor.current()

        if (
            preview
            and line
            and not line["hidden"]
            and not line["locked"]
            and line.get("kind") != "circle"
        ):
            painter.setPen(QPen(QColor("#426cf5"), 4))
            painter.setBrush(QColor("white"))

            for point in endpoints(line):
                painter.drawEllipse(point, 12, 12)

        painter.restore()

    def mousePressEvent(self, event):
        if event.button() != Qt.MouseButton.LeftButton:
            return

        self.setFocus()
        point = self.canvas_point(event)
        editor = self.editor

        if self.mode == "paint":
            for shape in reversed(editor.lines):
                if shape.get("kind") == "circle" and not shape["hidden"] and not shape["locked"] and distance(point, QPointF(shape["x"], shape["y"])) <= shape["length"] / 2:
                    editor.remember()
                    shape["fill"] = editor.fill_color
                    editor.refresh()
                    return
            matches = [
                (key, area)
                for key, points, area in closed_shapes(editor.lines)
                if polygon_path(points).contains(point)
            ]

            if matches:
                key = min(matches, key=lambda item: item[1])[0]
                editor.remember()
                editor.fills[key] = editor.fill_color
                editor.status.setText("Shape filled.")
                editor.refresh()
            else:
                editor.status.setText(
                    "Connect the endpoints to make a closed shape first."
                )

            return

        if self.mode == "draw":
            editor.remember()
            point = self.snap(point, set())
            line = editor.new_line(point.x(), point.y(), 1)
            self.drag = ("draw", line["id"], point)
            return

        line = editor.current()

        if line and not line["locked"] and not line["hidden"] and line.get("kind") != "circle":
            ends = endpoints(line)

            for index, endpoint in enumerate(ends):
                if distance(point, endpoint) < 14 / self.transform()[0]:
                    editor.remember()
                    self.drag = (
                        "endpoint",
                        line["id"],
                        index,
                        ends[1 - index],
                    )
                    return

        for line in reversed(editor.lines):
            if line["hidden"] or line["locked"]:
                continue

            a, b = endpoints(line)
            dx = b.x() - a.x()
            dy = b.y() - a.y()

            t = max(
                0,
                min(
                    1,
                    (
                        (point.x() - a.x()) * dx
                        + (point.y() - a.y()) * dy
                    )
                    / (dx * dx + dy * dy or 1),
                ),
            )

            closest = QPointF(a.x() + t * dx, a.y() + t * dy)
            threshold = max(
                12 / self.transform()[0],
                line["width"] / 2,
            )

            hit = distance(point, closest) <= threshold
            if line.get("kind") == "circle":
                radius_distance = distance(point, QPointF(line["x"], line["y"]))
                hit = abs(radius_distance - line["length"] / 2) <= threshold or (bool(line.get("fill")) and radius_distance <= line["length"] / 2)
            if hit:
                editor.selected = line["id"]
                editor.remember()

                group = connected_lines(editor.lines, line["id"])
                original = {
                    item["id"]: (item["x"], item["y"])
                    for item in editor.lines
                    if item["id"] in group
                }

                self.drag = ("move", line["id"], point, original)
                editor.refresh()
                return

        editor.selected = None
        editor.refresh()

    def mouseMoveEvent(self, event):
        if not self.drag:
            return

        point = self.canvas_point(event)
        kind, line_id, *details = self.drag
        line = self.editor.by_id(line_id)

        if line is None:
            return

        snapping = not (
            event.modifiers() & Qt.KeyboardModifier.AltModifier
        )

        if kind == "draw":
            if snapping:
                point = self.snap(point, {line_id})

            set_endpoints(line, details[0], point)

        elif kind == "endpoint":
            if snapping:
                point = self.snap(point, {line_id})

            index, fixed = details

            if index == 0:
                set_endpoints(line, point, fixed)
            else:
                set_endpoints(line, fixed, point)

        else:
            start, original = details
            dx = point.x() - start.x()
            dy = point.y() - start.y()

            for item_id, (x, y) in original.items():
                self.editor.by_id(item_id).update(x=x + dx, y=y + dy)

            if snapping and line.get("kind") != "circle":
                best = None
                threshold = 14 / self.transform()[0]
                ids = set(original)

                for item_id in ids:
                    for endpoint in endpoints(self.editor.by_id(item_id)):
                        target = self.snap(endpoint, ids)
                        amount = distance(endpoint, target)

                        if target != endpoint and amount < threshold:
                            best = (
                                target.x() - endpoint.x(),
                                target.y() - endpoint.y(),
                            )
                            threshold = amount

                if best:
                    for item_id in ids:
                        moved = self.editor.by_id(item_id)
                        moved["x"] += best[0]
                        moved["y"] += best[1]

        self.update()

    def mouseReleaseEvent(self, event):
        if not self.drag:
            return

        if self.drag[0] == "draw":
            line = self.editor.by_id(self.drag[1])

            if line and line["length"] < 3:
                self.editor.lines.remove(line)
                self.editor.selected = None

        self.drag = None
        self.editor.refresh()

    def keyPressEvent(self, event):
        if event.key() in (Qt.Key.Key_Delete, Qt.Key.Key_Backspace):
            self.editor.delete_line()
        else:
            super().keyPressEvent(event)


