            QSlider::handle:horizontal { background: #c2ff62; width: 16px; margin: -5px 0; border-radius: 8px; }
            QCheckBox { spacing: 8px; padding: 6px 0; }
            QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #737684; border-radius: 4px; }
            QCheckBox::indicator:checked { background: #c2ff62; border-color: #c2ff62; }
        """)
        self.refresh()

    @staticmethod
    def button(layout, title, action):
        button = QPushButton(title)
        button.clicked.connect(action)
        layout.addWidget(button)
        return button

    def by_id(self, line_id):
        return next(
            (line for line in self.lines if line["id"] == line_id),
            None,
        )

    def current(self):
        return self.by_id(self.selected)

    def remember(self):
        self.history.append(
            copy.deepcopy(
                (
                    self.lines,
                    self.fills,
                    self.selected,
                    self.next_id,
                    self.background,
                    self.transparent,
                )
            )
        )
        self.history = self.history[-60:]

    def undo(self):
        if not self.history:
            return

        (
            self.lines,
            self.fills,
            self.selected,
            self.next_id,
            self.background,
            self.transparent,
        ) = self.history.pop()

        self.refresh()

    def new_line(self, x=512, y=512, length=400):
        line = {
            "id": self.next_id,
            "name": f"Line {self.next_id}",
            "x": x,
            "y": y,
            "length": length,
            "angle": 0,
            "width": 40,
            "color": "#242738",
            "rounded": True,
            "hidden": False,
            "locked": False,
        }

        self.next_id += 1
        self.lines.append(line)
        self.selected = line["id"]
        self.refresh()
        return line

    def slider_value(self, key, value):
        if self.updating:
            return
        line = self.current()
        if line and not line["locked"]:
            if not self.sliders[key].isSliderDown():
                self.remember()
            line[key] = value
            self.refresh()

    def add_circle(self):
        self.remember()
        circle = self.new_line()
        circle.update(kind="circle", name=f"Circle {circle['id']}")
        self.canvas.mode = "select"
        self.paint_button.setChecked(False)
        self.refresh()

    def add_line(self):
        self.remember()
        self.new_line()
        self.canvas.mode = "select"
        self.paint_button.setChecked(False)

    def draw_mode(self):
        self.canvas.mode = "draw"
        self.paint_button.setChecked(False)
        self.status.setText("Drag on the canvas to draw a line.")

    def paint_mode(self):
        self.canvas.mode = (
            "paint" if self.paint_button.isChecked() else "select"
        )
        self.status.setText(
            "Click inside a closed shape to fill it."
            if self.canvas.mode == "paint"
            else "Select or move a line."
        )

    def duplicate(self):
        line = self.current()

        if line is None or line["locked"]:
            return

        self.remember()
        new = copy.deepcopy(line)
        new["id"] = self.next_id
        new["name"] = f"Line {self.next_id}"
        new["x"] += 35
        new["y"] += 35

        self.next_id += 1
        self.lines.append(new)
        self.selected = new["id"]
        self.refresh()

    def delete_line(self):
        line = self.current()

        if line is None or line["locked"]:
            return

        self.remember()
        self.lines.remove(line)
        self.selected = self.lines[-1]["id"] if self.lines else None
        self.refresh()

    def rotate(self, amount):
        line = self.current()

        if line is None or line["locked"]:
            return

        self.remember()
        line["angle"] = (line["angle"] + amount + 180) % 360 - 180
        self.refresh()

    def select_layer(self, item):
        self.selected = item.data(Qt.ItemDataRole.UserRole)
        self.refresh()

    def rename_layer(self):
        line = self.current()

        if line is None:
            return

        name = self.layer_name.text().strip()[:60]
        name = name or f"Line {line['id']}"

        if name != line["name"]:
            self.remember()
            line["name"] = name
            self.refresh()

    def toggle_hidden(self):
        line = self.current()

        if line:
            self.remember()
            line["hidden"] = not line["hidden"]
            self.refresh()

    def toggle_locked(self):
        line = self.current()

        if line:
            self.remember()
            line["locked"] = not line["locked"]
            self.refresh()

    def reorder(self, direction):
        line = self.current()

        if line is None or line["locked"]:
            return

        index = self.lines.index(line)
        target = index + direction

        if 0 <= target < len(self.lines):
            self.remember()
            self.lines[index], self.lines[target] = (
                self.lines[target],
                self.lines[index],
            )
            self.refresh()

    def apply_inline_color(self):
        if self.updating:
            return
        color = self.color_wheel.color().name()
        line = self.current()
        if self.wheel_fill.isChecked() or self.canvas.mode == "paint" or line is None:
            self.fill_color = color
        elif not line["locked"]:
            line["color"] = color
        self.refresh()

    def inline_brightness(self, value):
        if not self.updating:
            self.color_wheel.value = value / 100
            self.apply_inline_color()

    def choose_line_color(self):
        line = self.current()

        if line is None or line["locked"]:
            return

        color = choose_wheel_color(
            QColor(line["color"]), self, "Line color"
        )

        if color.isValid():
            self.remember()
            line["color"] = color.name()
            self.refresh()

    def choose_fill_color(self):
        color = choose_wheel_color(
            QColor(self.fill_color), self, "Fill color"
        )

        if color.isValid():
            self.fill_color = color.name()
            self.refresh()

    def save_color(self):
        line = self.current()
        color = (
            self.fill_color
            if self.wheel_fill.isChecked() or self.canvas.mode == "paint" or line is None
            else line["color"]
        )

        if color not in self.saved_colors:
            self.saved_colors.append(color)

        try:
            COLOR_FILE.parent.mkdir(parents=True, exist_ok=True)
            COLOR_FILE.write_text(json.dumps(self.saved_colors))
            self.status.setText("Color saved.")
        except OSError:
            self.status.setText("Color saved for this session only.")

        self.refresh()

    def apply_saved_color(self, item):
        color = item.data(Qt.ItemDataRole.UserRole)

        if self.wheel_fill.isChecked() or self.canvas.mode == "paint":
            self.fill_color = color
            self.refresh()
            return

        line = self.current()

        if line and not line["locked"]:
            self.remember()
            line["color"] = color
            self.refresh()

    def set_line_value(self, key, value):
        if self.updating:
            return

        line = self.current()

        if line and not line["locked"] and line[key] != value:
            self.remember()
            line[key] = value
            self.canvas.update()

    def set_transparent(self, value):
        if self.updating:
            return

        self.remember()
        self.transparent = value
        self.canvas.update()

    def choose_background(self):
        color = choose_wheel_color(
            QColor(self.background), self, "Background color"
        )

        if color.isValid():
            self.remember()
            self.background = color.name()
            self.canvas.update()

    def clear_fills(self):
        if self.fills or any(line.get("fill") for line in self.lines):
            self.remember()
            self.fills = {}
            for line in self.lines:
                line.pop("fill", None)
            self.refresh()

    def refresh(self):
        self.updating = True
        self.layer_list.clear()

        for line in reversed(self.lines):
            title = line["name"]

            if line["hidden"]:
                title += "  [hidden]"
            if line["locked"]:
                title += "  [locked]"

            item = QListWidgetItem(title)
            item.setData(Qt.ItemDataRole.UserRole, line["id"])
            self.layer_list.addItem(item)

            if line["id"] == self.selected:
                self.layer_list.setCurrentItem(item)

        line = self.current()
        self.layer_name.setText(line["name"] if line else "")
        editable = line is not None and not line["locked"]

        for key, control in self.controls.items():
            enabled = editable and not (key == "angle" and line.get("kind") == "circle")
            control.setEnabled(enabled)
            self.sliders[key].setEnabled(enabled)
            if line:
                control.setValue(round(line[key]))
                self.sliders[key].setValue(round(line[key]))

        self.rounded.setEnabled(editable)

        if line:
            self.rounded.setChecked(line["rounded"])

        self.transparent_checkbox.setChecked(self.transparent)

        self.palette.clear()

        for color in self.saved_colors:
            item = QListWidgetItem(color.upper())
            item.setData(Qt.ItemDataRole.UserRole, color)
            item.setBackground(QColor(color))
            item.setForeground(
                QColor("#111111")
                if QColor(color).lightness() > 130
                else QColor("#ffffff")
            )
            self.palette.addItem(item)

        color = QColor(self.fill_color if self.wheel_fill.isChecked() or self.canvas.mode == "paint" or line is None else line["color"])
        hue = color.hsvHueF()
        if hue >= 0:
            self.color_wheel.hue = hue
        self.color_wheel.saturation = color.hsvSaturationF()
        self.color_wheel.value = color.valueF()
        self.brightness.setValue(round(color.valueF() * 100))
        self.color_wheel.update()
        self.fill_button.setText(color.name().upper())
        self.fill_button.setStyleSheet(f"border-bottom: 4px solid {color.name()};")

        self.updating = False
        self.canvas.update()

    def export_png(self):
        filename, _ = QFileDialog.getSaveFileName(
            self,
            "Export logo",
            "channel-logo.png",
            "PNG images (*.png)",
        )

        if not filename:
            return

        if not filename.lower().endswith(".png"):
            filename += ".png"

        image = QImage(
            CANVAS_SIZE,
            CANVAS_SIZE,
            QImage.Format.Format_ARGB32,
        )
        image.fill(Qt.GlobalColor.transparent)

        painter = QPainter(image)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        self.canvas.draw_logo(painter)
        painter.end()

        if image.save(filename, "PNG"):
            self.status.setText(f"Exported {filename}")
        else:
            QMessageBox.warning(
                self, "Export failed", "The PNG could not be saved."
            )

    def project_data(self):
        return {"format": "SnapMark", "version": 1, "lines": self.lines,
                "fills": self.fills, "background": self.background,
                "transparent": self.transparent, "fill_color": self.fill_color}

    def load_project_data(self, data):
        if not isinstance(data, dict) or data.get("format") != "SnapMark" or data.get("version") != 1:
            raise ValueError("This is not a supported SnapMark project.")
        lines = copy.deepcopy(data["lines"])
        if not isinstance(lines, list) or len(lines) > 5000:
            raise ValueError("Invalid object list.")
        ids = set()
        for line in lines:
            if not isinstance(line, dict) or type(line.get("id")) is not int or line["id"] in ids:
                raise ValueError("Invalid object ID.")
            ids.add(line["id"])
            if line.get("kind", "line") not in ("line", "circle") or not isinstance(line.get("name"), str):
                raise ValueError("Invalid object.")
            for key in ("x", "y", "length", "angle", "width"):
                value = line.get(key)
                if type(value) not in (int, float) or not math.isfinite(value) or abs(value) > 100000:
                    raise ValueError("Invalid dimensions.")
            if line["length"] <= 0 or line["width"] <= 0:
                raise ValueError("Dimensions must be positive.")
            for key in ("hidden", "locked", "rounded"):
                if type(line.get(key)) is not bool:
                    raise ValueError("Invalid object setting.")
            for key in ("color", "fill"):
                if key in line and (not isinstance(line[key], str) or not QColor(line[key]).isValid()):
                    raise ValueError("Invalid color.")
        fills = data.get("fills", {})
        if not isinstance(fills, dict) or any(not isinstance(v, str) or not QColor(v).isValid() for v in fills.values()):
            raise ValueError("Invalid fills.")
        for key in ("background", "fill_color"):
            if not isinstance(data.get(key), str) or not QColor(data[key]).isValid():
                raise ValueError("Invalid project color.")
        if type(data.get("transparent")) is not bool:
            raise ValueError("Invalid background setting.")
        self.remember()
        self.lines, self.fills = lines, copy.deepcopy(fills)
        self.background, self.transparent = data["background"], data["transparent"]
        self.fill_color = data["fill_color"]
        self.next_id = max(ids, default=0) + 1
        self.selected = lines[-1]["id"] if lines else None
        self.canvas.drag = None
        self.canvas.mode = "select"
        self.paint_button.setChecked(False)
        self.refresh()

    def save_project(self):
        filename, _ = QFileDialog.getSaveFileName(self, "Save Project", "SnapMark.snapmark", "SnapMark project (*.snapmark)")
        if not filename:
            return
        if not filename.lower().endswith(".snapmark"):
            filename += ".snapmark"
        try:
            target = Path(filename)
            temporary = target.with_name(target.name + ".tmp")
            temporary.write_text(json.dumps(self.project_data(), indent=2), encoding="utf-8")
            temporary.replace(target)
            self.status.setText("Project saved. Use Open Project to edit it later.")
        except OSError as error:
            QMessageBox.warning(self, "Save failed", str(error))

    def open_project(self):
        filename, _ = QFileDialog.getOpenFileName(self, "Open Project", "", "SnapMark project (*.snapmark)")
        if not filename:
            return
        if self.lines and QMessageBox.question(self, "Open Project", "Replace the current drawing? Save it first if you want to keep it.") != QMessageBox.StandardButton.Yes:
            return
        try:
            self.load_project_data(json.loads(Path(filename).read_text(encoding="utf-8")))
            self.status.setText("Project opened.")
        except (OSError, ValueError, KeyError, TypeError) as error:
            QMessageBox.warning(self, "Open failed", str(error))

    def closeEvent(self, event):
        if not self.lines:
            event.accept()
            return

        answer = QMessageBox.question(
            self,
            "Close SnapMark?",
            "Close this drawing? Use Save Project to keep it editable, or Export PNG for an image.",
            QMessageBox.StandardButton.Yes
            | QMessageBox.StandardButton.No,
        )

        if answer == QMessageBox.StandardButton.Yes:
            event.accept()
        else:
            event.ignore()


